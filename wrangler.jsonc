{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chatbot-worker",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-chat-db",
      "database_id": "f303aedb-36e5-4e99-a8f3-4084729f3ae2",
      "migrations_dir": "migrations"
    }
  ]
}
